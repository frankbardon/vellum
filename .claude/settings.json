{
  "permissions": {
    "allow": [
      "Bash(env)",
      "Bash(go build:*)",
      "Bash(go doc *)",
      "Bash(go get:*)",
      "Bash(go mod:*)",
      "Bash(go test:*)",
      "Bash(go tool:*)",
      "Bash(go version:*)",
      "Bash(go vet:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(make build:*)",
      "Bash(make fmt:*)",
      "Bash(make lint:*)",
      "Bash(make test:*)",
      "Bash(make vet:*)",
      "Bash(staticcheck:*)",
      "Bash(wc:*)",
      "Bash(./bin/vellum)",
      "Bash(./bin/vellum --help)",
      "Bash(./bin/vellum capabilities:*)",
      "Bash(./bin/vellum compose:*)",
      "Bash(./bin/vellum inspect:*)",
      "Bash(./bin/vellum schema:*)",
      "Bash(./bin/vellum skills:*)",
      "Bash(./bin/vellum validate:*)",
      "WebFetch(domain:github.com)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/fetch-issue-context.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
