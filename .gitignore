# Claude
.claude/settings.local.json
.planning/*

# Binaries
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test & coverage
*.test
*.out
coverage.out
coverage.html
*.prof

# Go workspace
go.work
go.work.sum
vendor/

# Dependency dirs
Godeps/

# Vellum artifacts
#
# Generated documents are build output and are not tracked. Committed goldens
# live under a testdata/ directory somewhere in the tree, so that whole subtree
# is negated — a pattern anchored at the repository root would miss
# internal/dettest/testdata/ and quietly leave a golden untracked, which is how
# a determinism gate comes to pass locally and fail in CI.
*.docx
*.xlsx
*.pptx
*.pdf
!**/testdata/**

# Docs (mdBook build output)
docs/book/

# Project
.planning/
.worktrees/
tmp/
tmp-bench/

# Editors
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.local
.planning/*/.flow-runtime/
